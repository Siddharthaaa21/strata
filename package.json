{
  "name": "strata",
  "version": "0.0.0",
  "private": true,
  "description": "AI engineering workspace — searchable knowledge base for humans and agents",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @strata/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "node --test",
    "graph": "node scripts/graph.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run graph -- --check && npm run scan",
    "scan": "node scripts/nul-scan.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "ingest": "node scripts/ingest.mjs",
    "search": "node scripts/search.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "globals": "^15.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
