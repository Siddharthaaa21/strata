# Copy to .env and fill in. .env is gitignored — never commit a real connection string or private keys.

# ==============================================================================
# Database Configuration
# ==============================================================================
# Remote Postgres (Supabase, Neon, AWS RDS, etc.):
# For Supabase: Project Settings -> Database -> Connection string -> Session pooler (Port 5432 or 6543).
#   postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# For Neon:
#   postgresql://<user>:<password>@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require
#
# For zero-config offline local development, you can set DATABASE_URL=local or run with STRATA_LOCAL_DB=1.
DATABASE_URL=

# Any stable string identifying the tenant/workspace (e.g. ws-personal, ws-team).
STRATA_WORKSPACE_ID=ws-personal

# ==============================================================================
# Supabase Authentication (Required for Production Human Sessions)
# ==============================================================================
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# Document Assistant LLM Provider Keys (Optional — picks the first configured key)
# ==============================================================================
# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI / Compatible endpoint (https://platform.openai.com/)
OPENAI_API_KEY=

# Local Ollama endpoint (defaults to http://127.0.0.1:11434 if unset)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==============================================================================
# Connectors (Optional)
# ==============================================================================
# GitHub personal access token (optional for public repositories; required for private repos & high rate limits)
GITHUB_TOKEN=

# ==============================================================================
# Local Development Shortcuts (Optional)
# ==============================================================================
# Set to 1 to bypass Supabase OAuth and use the instant local session issuer:
# STRATA_DEV_AUTH=1
# STRATA_DEV_EMAIL=user@example.com
# STRATA_LOCAL_DB=1
