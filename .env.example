# Copy to .env and fill in. .env is gitignored — never commit a real connection string.
#
# Supabase: Connect -> Session pooler -> URI tab. Use the POOLER host, not db.<project>.supabase.co
# (direct connections are IPv6-only on the free tier and will time out on most networks).
#   postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Neon: postgresql://<user>:<password>@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require
#
# There is deliberately no default. A silent localhost fallback is how a process ends up writing
# to the wrong database.
DATABASE_URL=

# Any stable string. Identifies the workspace the MCP server serves.
STRATA_WORKSPACE_ID=ws-personal
