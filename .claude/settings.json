{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "STRATA_ENV": "development"
  },
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm ls:*)",
      "Bash(node scripts/*)",
      "Bash(node --test:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(git push -u origin m*:*)",
      "Bash(git push origin m*:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Bash(npm publish:*)",
      "Bash(rm -rf:*)",
      "Edit(./design/handoff/**)",
      "Write(./design/handoff/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git push origin HEAD:main:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/binary-guard.sh"
          }
        ]
      }
    ]
  }
}
